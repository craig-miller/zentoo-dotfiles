#!/usr/bin/env bash
set -euo pipefail

agent=""
model=""
threshold=""
confirm_count=""
cooldown=""
display_name=""
venv="${VIOLAWAKE_VENV:-}"
voice_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/ai-voice-to-herdr"
session_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/ai-voice-session"
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/ai-voice/config.toml"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/ai-voice"
log_file="${AI_WAKE_LOG:-/tmp/ai-wake.log}"

usage() {
  cat <<EOF
Usage: ai-wake [options]

Listen for configured ViolaWake model(s) and launch ai-voice-to-herdr for the
selected agent.

Options:
  --agent NAME       Agent to route post-wake speech to
  --model PATH       ONNX wake model
  --threshold NUM    Detection threshold
  --confirm-count N  Consecutive above-threshold frames required
  --cooldown SEC     Seconds between wake triggers
  --display-name STR PipeWire/Noctalia stream name
  --venv PATH        ViolaWake venv fallback (default: VIOLAWAKE_VENV, if set)
  --config PATH      Config file (default: $config_file)
  -h, --help         Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent) agent="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --threshold) threshold="$2"; shift 2 ;;
    --confirm-count) confirm_count="$2"; shift 2 ;;
    --cooldown) cooldown="$2"; shift 2 ;;
    --display-name) display_name="$2"; shift 2 ;;
    --venv) venv="$2"; shift 2 ;;
    --config) config_file="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

mkdir -p "$runtime_dir"
exec 9>"$runtime_dir/wake.lock"
if ! flock -n 9; then
  echo "another ai-wake is already running" >&2
  exit 0
fi
printf '%s\n' "$$" >"$runtime_dir/wake.pid"
trap 'rm -f "$runtime_dir/wake.pid"' EXIT

python_bin="${VIOLAWAKE_PYTHON:-}"
if [[ -z "$python_bin" ]]; then
  if python3 -c 'import violawake_sdk' >/dev/null 2>&1; then
    python_bin="python3"
  elif [[ -n "$venv" && -x "$venv/bin/python" ]]; then
    python_bin="$venv/bin/python"
  elif [[ -x "/tmp/violawake-console-venv311/bin/python" ]]; then
    python_bin="/tmp/violawake-console-venv311/bin/python"
  else
    echo "ViolaWake is not available. Install dev-python/violawake or set VIOLAWAKE_VENV/VIOLAWAKE_PYTHON." >&2
    exit 1
  fi
fi
if [[ ! -x "$voice_bin" ]]; then
  echo "ai-voice-to-herdr not found: $voice_bin" >&2
  exit 1
fi

exec "$python_bin" - \
  "$config_file" "$agent" "$model" "$threshold" "$confirm_count" "$cooldown" "$display_name" "$voice_bin" "$log_file" "$session_bin" <<'PY'
from __future__ import annotations

import contextlib
import os
import subprocess
import sys
import time
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover
    tomllib = None

from violawake_sdk import WakeDetector

config_file = Path(sys.argv[1])
arg_agent, arg_model, arg_threshold, arg_confirm, arg_cooldown, arg_display = sys.argv[2:8]
voice_bin = sys.argv[8]
log_file = Path(sys.argv[9])
session_bin = sys.argv[10]


def load_config() -> dict:
    if tomllib is None or not config_file.exists():
        return {}
    with config_file.open("rb") as fh:
        return tomllib.load(fh)


def expand_path(value: str) -> str:
    return os.path.expandvars(os.path.expanduser(value))


def log(message: str) -> None:
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}"
    print(line, flush=True)
    with log_file.open("a", encoding="utf-8") as fh:
        fh.write(line + "\n")


config = load_config()
wake = config.get("wake", {}) if isinstance(config.get("wake", {}), dict) else {}
assistant = config.get("assistant", {}) if isinstance(config.get("assistant", {}), dict) else {}

if not os.environ.get("AI_WAKE_FORCE") and wake.get("enabled") is False:
    log("wake listener disabled in config; exiting")
    raise SystemExit(0)

def word_cooldown_s(word: dict) -> float:
    if word.get("cooldown_s") is not None:
        return float(word["cooldown_s"])
    if word.get("cooldown_ms") is not None:
        return float(word["cooldown_ms"]) / 1000.0
    if wake.get("cooldown_s") is not None:
        return float(wake["cooldown_s"])
    return float(wake.get("cooldown_ms", 2000)) / 1000.0


words_value = wake.get("words")
configured_words: list[dict] = []
if isinstance(words_value, list):
    configured_words = [w for w in words_value if isinstance(w, dict)]

if arg_agent or arg_model:
    agent = arg_agent or str(assistant.get("default_agent") or config.get("default_agent") or "carrie")
    configured_words = [{
        "phrase": agent,
        "agent": agent,
        "model": arg_model or wake.get("model") or f"~/.local/share/ai-voice/wake/{agent}.onnx",
        "threshold": arg_threshold or wake.get("threshold") or 0.80,
        "confirm_count": arg_confirm or wake.get("confirm_count") or 3,
        "cooldown_s": arg_cooldown or word_cooldown_s({}),
        "display_name": arg_display or wake.get("display_name") or assistant.get("display_name") or "AI Wake Listener",
    }]
elif not configured_words:
    agent = str(assistant.get("default_agent") or config.get("default_agent") or "carrie")
    configured_words = [{
        "phrase": agent,
        "agent": agent,
        "model": wake.get("model") or f"~/.local/share/ai-voice/wake/{agent}.onnx",
        "threshold": wake.get("threshold") or 0.80,
        "confirm_count": wake.get("confirm_count") or 3,
        "cooldown_s": word_cooldown_s({}),
        "display_name": wake.get("display_name") or assistant.get("display_name") or "AI Wake Listener",
    }]

detector_configs = []
for index, word in enumerate(configured_words):
    agent = str(word.get("agent") or word.get("phrase") or assistant.get("default_agent") or config.get("default_agent") or "carrie")
    model = expand_path(str(word.get("model") or wake.get("model") or f"~/.local/share/ai-voice/wake/{agent}.onnx"))
    if not Path(model).is_file():
        raise SystemExit(f"Wake model not found for {agent}: {model}")
    detector_configs.append({
        "index": index,
        "phrase": str(word.get("phrase") or agent),
        "agent": agent,
        "model": model,
        "threshold": float(arg_threshold or word.get("threshold") or wake.get("threshold") or 0.80),
        "confirm_count": int(arg_confirm or word.get("confirm_count") or wake.get("confirm_count") or 3),
        "cooldown": float(arg_cooldown or word_cooldown_s(word)),
        "above": 0,
        "last_wake": 0.0,
        "max_score": 0.0,
        "kind": str(word.get("kind") or word.get("action") or "open").lower(),
    })

display_name = arg_display or str(wake.get("display_name") or assistant.get("display_name") or "AI Wake Listener")
global_last_wake = 0.0

rate = 16000
frame_samples = 320
frame_bytes = frame_samples * 2
safe_node_name = "ai-voice.wake"
props = f"application.name={display_name},media.name={display_name},node.name={safe_node_name}"
cmd = [
    "pw-record",
    "--rate", str(rate),
    "--channels", "1",
    "--format", "s16",
    "--raw",
    "--media-type", "Audio",
    "--media-category", "Capture",
    "--media-role", "Communication",
    "--properties", props,
    "-",
]

log(
    f"starting ai-wake words={len(detector_configs)} display_name={display_name!r} "
    + ", ".join(
        f"{cfg['phrase']}->{cfg['agent']} kind={cfg['kind']} threshold={cfg['threshold']} "
        f"confirm_count={cfg['confirm_count']} cooldown={cfg['cooldown']}s model={cfg['model']}"
        for cfg in detector_configs
    )
)
proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
try:
    with contextlib.ExitStack() as stack:
        for cfg in detector_configs:
            cfg["detector"] = stack.enter_context(
                WakeDetector(
                    model=cfg["model"],
                    threshold=cfg["threshold"],
                    confirm_count=cfg["confirm_count"],
                    backend="onnx",
                )
            )
        while True:
            data = proc.stdout.read(frame_bytes) if proc.stdout else b""
            if len(data) < frame_bytes:
                log("audio stream ended")
                break
            now = time.monotonic()
            best_trigger = None
            for cfg in detector_configs:
                score = cfg["detector"].process(data)
                cfg["max_score"] = max(cfg["max_score"], score)
                if score >= cfg["threshold"]:
                    cfg["above"] += 1
                else:
                    cfg["above"] = 0
                if (
                    cfg["above"] >= cfg["confirm_count"]
                    and now - cfg["last_wake"] >= cfg["cooldown"]
                    and now - global_last_wake >= cfg["cooldown"]
                ):
                    if best_trigger is None or score > best_trigger[1]:
                        best_trigger = (cfg, score)
            if best_trigger is not None:
                cfg, score = best_trigger
                global_last_wake = now
                for other in detector_configs:
                    other["above"] = 0
                    other["last_wake"] = now
                    other["detector"].reset_cooldown()
                kind = cfg["kind"]
                log(
                    f"wake detected phrase={cfg['phrase']} agent={cfg['agent']} kind={kind} "
                    f"score={score:.3f} max={cfg['max_score']:.3f}"
                )
                if kind in {"close", "end", "deactivate", "inactive"}:
                    if Path(session_bin).is_file() and os.access(session_bin, os.X_OK):
                        subprocess.run([session_bin, "deactivate", cfg["agent"]], check=False)
                    log(f"voice session deactivated agent={cfg['agent']} phrase={cfg['phrase']}")
                else:
                    env = os.environ.copy()
                    env["AI_VOICE_WAKE_KIND"] = "open"
                    env["AI_VOICE_WAKE_PHRASE"] = cfg["phrase"]
                    subprocess.Popen([voice_bin, cfg["agent"]], env=env)
except KeyboardInterrupt:
    log("stopping ai-wake")
finally:
    proc.terminate()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill()
PY

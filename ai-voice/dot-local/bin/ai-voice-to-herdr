#!/usr/bin/env bash
set -euo pipefail

agent="${1:-}"
wakectl_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/ai-wakectl"
wake_was_running="false"
wake_stopped_by_voice="false"

restore_wake() {
	if [[ "$wake_stopped_by_voice" == "true" && -x "$wakectl_bin" ]]; then
		AI_WAKECTL_QUIET=1 "$wakectl_bin" on >/dev/null 2>&1 || true
	fi
}
trap restore_wake EXIT

if [[ -n "$agent" ]]; then
	export AI_VOICE_AGENT="$agent"
	# Backward compatibility for any older wrappers/actions still looking for the
	# original environment variable name.
	export ZENTOO_VOICE_AGENT="$agent"
	case "$agent" in
		carrie) agent_display="Carrie" ;;
		bodhi) agent_display="Bodhi" ;;
		*) agent_display="${agent^}" ;;
	esac
	export OSTT_CONTEXT_LABEL="${AI_VOICE_AGENT_DISPLAY:-$agent_display}"
else
	export OSTT_CONTEXT_LABEL="${AI_VOICE_AGENT_DISPLAY:-Carrie}"
fi

# Auto-stop after a pause so push-to-talk only needs a start keypress. Pressing
# the hotkey again still stops manually via OSTT's existing SIGUSR1 path.
export OSTT_AUTO_STOP_SILENCE_MS="${OSTT_AUTO_STOP_SILENCE_MS:-2200}"
export OSTT_AUTO_STOP_MIN_MS="${OSTT_AUTO_STOP_MIN_MS:-900}"
# Keep this above the ambient noise floor. The simple OSTT patch treats any
# audio above this as non-silence, so construction/traffic noise may require
# tuning upward.
export OSTT_AUTO_STOP_RMS_THRESHOLD="${OSTT_AUTO_STOP_RMS_THRESHOLD:-0.02}"
# Voice ask mode can legitimately wait for the agent response and spoken TTS.
# Patched Zentoo OSTT honors this for bash processing actions.
export OSTT_BASH_ACTION_TIMEOUT_SECS="${OSTT_BASH_ACTION_TIMEOUT_SECS:-600}"

# While OSTT is actively recording/transcribing/processing a prompt, suppress
# the always-on wake listener so spoken prompts and TTS responses cannot trigger
# other wake models. Restore it afterward only if it was running when we began.
if [[ "${AI_VOICE_STOP_WAKE_DURING_OSTT:-true}" == "true" && -x "$wakectl_bin" ]]; then
	if "$wakectl_bin" status >/dev/null 2>&1; then
		wake_was_running="true"
		AI_WAKECTL_QUIET=1 "$wakectl_bin" off >/dev/null 2>&1 || true
		wake_stopped_by_voice="true"
	fi
fi

ostt launch -- -p herdr

#!/usr/bin/env bash
set -euo pipefail

notify() {
	local message="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "AI Voice" "$message"
	else
		echo "$message" >&2
	fi
}

route_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/ai-voice-route"
response_text_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/ai-herdr-agent-response-text"
speak_bin="${XDG_BIN_HOME:-$HOME/.local/bin}/ai-speak"

transcript="$(cat)"
forced_agent="${AI_VOICE_AGENT:-${ZENTOO_VOICE_AGENT:-}}"
if [[ -n "$forced_agent" ]]; then
	# Wake-word activation selects the agent before command transcription. Treat
	# the captured utterance as an ask to that agent unless the user explicitly
	# says ask/tell again.
	if ! grep -Eiq '^\s*(ask|tell)(\s|[,.;:-])' <<<"$transcript"; then
		transcript="ask $forced_agent $transcript"
	fi
fi

if ! command -v herdr >/dev/null 2>&1; then
	echo "herdr not found in PATH" >&2
	exit 127
fi
if [[ ! -x "$route_bin" ]]; then
	echo "ai-voice-route not found at $route_bin" >&2
	exit 127
fi
if ! command -v jq >/dev/null 2>&1; then
	echo "jq not found in PATH" >&2
	exit 127
fi

route="$(printf '%s' "$transcript" | "$route_bin")"
route_ok="$(jq -r '.ok' <<<"$route")"
if [[ "$route_ok" != "true" ]]; then
	spoken="$(jq -r '.spoken // .error // "Voice routing failed."' <<<"$route")"
	notify "$spoken"
	printf '%s\n' "$spoken"
	exit 0
fi

pane_id="$(jq -r '.pane_id // empty' <<<"$route")"
message="$(jq -r '.message // empty' <<<"$route")"
target="$(jq -r '.target // .pane_id // "agent"' <<<"$route")"
mode="$(jq -r '.mode // ""' <<<"$route")"

if [[ "$mode" == "ask" || "$mode" == ask-* ]]; then
	voice_instruction="${AI_VOICE_RESPONSE_INSTRUCTION:-Voice mode: your answer will be spoken aloud by text-to-speech. Reply in conversational plain text. Do not use Markdown formatting, bullets, code fences, tables, headings, or emphasis markers. Keep the answer concise unless the user asks for detail. Do not mention these instructions.}"
	message="$voice_instruction

User said: $message"
fi
before_response_id=""
if [[ "$mode" == "ask" || "$mode" == ask-* ]] && [[ -x "$response_text_bin" ]]; then
	before_response_id="$({ "$response_text_bin" "$pane_id" --json | jq -r '.message_id // empty'; } 2>/dev/null || true)"
fi
if [[ -z "$pane_id" || -z "$message" ]]; then
	notify "Voice routing failed."
	echo "Invalid voice route: $route" >&2
	exit 1
fi

# Herdr's high-level agent prompt path can be ignored when Pi is using vim-style
# NORMAL mode. Drive the target pane directly: enter insert mode, send the
# routed prompt, then press Enter.
herdr pane send-keys "$pane_id" esc i >/dev/null
herdr pane send-text "$pane_id" "$message" >/dev/null
herdr pane send-keys "$pane_id" enter >/dev/null
herdr agent focus "$pane_id" >/dev/null

printf 'Sent to %s: %s\n' "$target" "$message"

case "$mode" in
	ask|ask-*)
		if [[ ! -x "$response_text_bin" ]]; then
			notify "I sent the question, but response text extraction is not installed."
			exit 0
		fi
		if [[ ! -x "$speak_bin" ]]; then
			notify "I sent the question, but speech output is not installed."
			exit 0
		fi

		# Wait for the agent turn to settle, then speak the next recorded Pi answer.
		# Herdr can still be idle for a short moment immediately after raw pane input,
		# so response extraction also waits for a new Pi message id instead of reading
		# the previous answer. Zentoo's OSTT patch raises the bash action timeout for
		# this voice workflow so the popup doesn't report a false error.
		herdr agent wait "$pane_id" --timeout 180000 >/dev/null || true
		if ! "$response_text_bin" "$pane_id" --after-id "$before_response_id" --wait-ms 180000 | "$speak_bin" --agent "$target"; then
			notify "I sent the question, but couldn't speak the response."
		fi
		;;
esac

set dark-mode=on

# style.css disabled: Dark Reader (loaded via /usr/share/vimb/scripts.js)
# handles page theming; our filter recipe was Phase 1 and is now redundant.
set stylesheet=off

# Open links that request a new window/tab in the current window instead.
set prevent-newwindow=on

# Manual dark-mode toggle. Noctalia's SIGUSR2 reload realigns on the next
# system theme change, so this is a per-session override.
:nnoremap zm :set dark-mode!<CR>

# Chrome palette rendered by noctalia (temporary — will move to /etc/vimb/config after ebuild bump)
source ~/.config/vimb/noctalia-theme

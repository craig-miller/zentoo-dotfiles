# Catppuccin Mocha for sioyek's custom-color mode (softer than pure dark).
custom_background_color 0.118 0.118 0.180
custom_text_color 0.804 0.839 0.957

startup_commands toggle_custom_color

# Zettelkasten workflow - batch-export all 'f'-color highlights from the
# current PDF as per-quote cards under ~/research/papers/<citekey>/.
# The 'f' color is the promotion signal ("file it in the Zettelkasten").
# Other colors (default 'a' = yellow etc.) stay as read-markers only.
#
# NOTE: sioyek's prefs parser uses plain std::wifstream with no UTF-8
# codecvt locale, so any multi-byte character (em-dash, curly quotes, etc.)
# in this file corrupts parsing of all following lines. Keep this file
# strictly ASCII.
#
# Capture gesture lives directly in keys_user.config; export command here.
# NOTE: no quotes around %{...} placeholders. Sioyek splits the command on
# whitespace but does NOT strip surrounding quotes, so "..." becomes literal
# quote-chars in the child argv. Our substituted paths contain no spaces, so
# unquoted works. If a path ever needed a space, escape it with backslash
# per sioyek's docs. Also: new_command definitions are cached at
# CommandManager construction (input.cpp:7478) and do NOT hot-reload; edits
# here require a full sioyek quit+reopen to take effect.
new_command _zettel_export /home/craig/.local/bin/zettel-export %{file_path} %{shared_database} %{local_database}

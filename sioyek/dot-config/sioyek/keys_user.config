# Sioyek's default keys are already vim-adjacent (j/k/h/l, gg/G, u/d, /
# search, : command mode, f follow-link, m mark, ` jump-to-mark). Add
# overrides here as needed.

# Zettelkasten capture + export. Sioyek uses bare capital letters for
# shift-letter binds (not `<S-h>`); see /etc/sioyek/keys.config where
# defaults show `goto_end G`, `previous_item N`, etc.
#
# H = highlight the current selection with color 'f' (promote-worthy).
# Z = batch-export all 'f'-color highlights from current PDF as cards.
# Annotation, if desired, is separate: sioyek's `add_annot_to_selected_highlight`
# on the just-highlighted region (unbound by default; add a key if we later
# want a smoother in-flow annotation gesture).
add_highlight(f); add_annot_to_selected_highlight   H
_export_highlights                                      Z

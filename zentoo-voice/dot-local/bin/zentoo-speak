#!/usr/bin/env python3
"""Speak text locally for Zentoo voice workflows.

Reads text from arguments or stdin. Uses named voices from
~/.config/zentoo-voice/config.toml, preferring Piper when configured and falling
back to espeak-ng for a no-model baseline.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover
    tomllib = None


def config_path() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "zentoo-voice" / "config.toml"


def load_config() -> dict[str, Any]:
    path = config_path()
    if not path.exists() or tomllib is None:
        return {}
    with path.open("rb") as fh:
        return tomllib.load(fh)


def expand(value: Any) -> str:
    return os.path.expandvars(os.path.expanduser(str(value))) if value is not None else ""


def have(command: str) -> bool:
    return subprocess.run(["sh", "-c", f"command -v {command} >/dev/null 2>&1"]).returncode == 0


def voice_config(config: dict[str, Any], voice_name: str | None, agent_name: str | None) -> tuple[str, dict[str, Any]]:
    tts = config.get("tts", {}) if isinstance(config.get("tts", {}), dict) else {}
    voices = tts.get("voices", {}) if isinstance(tts.get("voices", {}), dict) else {}
    agent_voices = tts.get("agent_voices", {}) if isinstance(tts.get("agent_voices", {}), dict) else {}

    selected = voice_name
    if not selected and agent_name:
        selected = str(agent_voices.get(agent_name, "") or agent_name)
    if not selected:
        selected = str(tts.get("default_voice", "") or "default")

    base: dict[str, Any] = {
        "backend": tts.get("backend", "auto"),
        "espeak_voice": tts.get("espeak_voice", "en-us"),
        "espeak_speed": tts.get("espeak_speed", 165),
        "piper_model": tts.get("piper_model", ""),
        "piper_config": tts.get("piper_config", ""),
        "piper_speaker": tts.get("piper_speaker", ""),
        "server_enabled": tts.get("server_enabled", True),
        "server_url": tts.get("server_url", "http://127.0.0.1:50321"),
    }

    specific = voices.get(selected, {}) if isinstance(voices.get(selected, {}), dict) else {}
    base.update(specific)
    return selected, base


def speak_piper_server(text: str, voice_name: str, cfg: dict[str, Any]) -> bool:
    if not bool(cfg.get("server_enabled", True)):
        return False

    url = str(cfg.get("server_url") or "http://127.0.0.1:50321").rstrip("/") + "/synthesize"
    payload = json.dumps({"text": text, "voice": voice_name}).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=3) as response:
            wav_data = response.read()
    except (OSError, urllib.error.URLError):
        return False

    with tempfile.NamedTemporaryFile(prefix="zentoo-speak-", suffix=".wav", delete=False) as fh:
        wav = Path(fh.name)
        fh.write(wav_data)

    try:
        subprocess.run(["pw-play", str(wav)], check=True)
    finally:
        wav.unlink(missing_ok=True)
    return True


def speak_piper(text: str, cfg: dict[str, Any]) -> None:
    model = expand(cfg.get("model") or cfg.get("piper_model"))
    config = expand(cfg.get("config") or cfg.get("piper_config"))
    speaker = expand(cfg.get("speaker") or cfg.get("piper_speaker"))

    if not model:
        raise RuntimeError("Piper voice has no model path")
    if not Path(model).is_file():
        raise RuntimeError(f"Piper model not found: {model}")

    with tempfile.NamedTemporaryFile(prefix="zentoo-speak-", suffix=".wav", delete=False) as fh:
        wav = Path(fh.name)

    try:
        cmd = ["piper", "--model", model, "--output_file", str(wav)]
        if config:
            cmd.extend(["--config", config])
        if speaker:
            cmd.extend(["--speaker", speaker])
        subprocess.run(
            cmd,
            input=text + "\n",
            text=True,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        subprocess.run(["pw-play", str(wav)], check=True)
    finally:
        wav.unlink(missing_ok=True)


def speak_espeak(text: str, cfg: dict[str, Any]) -> None:
    voice = expand(cfg.get("espeak_voice") or "en-us")
    speed = str(cfg.get("espeak_speed") or 165)
    espeak = subprocess.Popen(["espeak-ng", "-v", voice, "-s", speed, "--stdout", text], stdout=subprocess.PIPE)
    try:
        subprocess.run(["pw-play", "--media-role=Speech", "-"], stdin=espeak.stdout, check=True)
    finally:
        if espeak.stdout:
            espeak.stdout.close()
        espeak.wait()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--backend", choices=("auto", "piper", "espeak", "espeak-ng"), help="override configured backend")
    parser.add_argument("--voice", help="named TTS voice from [tts.voices]")
    parser.add_argument("--agent", help="agent name; resolved through [tts.agent_voices]")
    parser.add_argument("--json", action="store_true", help="print selected voice/backend metadata instead of speaking")
    parser.add_argument("text", nargs="*")
    args = parser.parse_args()

    text = " ".join(args.text) if args.text else sys.stdin.read()
    text = text.replace("\r", "").strip()
    if not text and not args.json:
        return 0

    config = load_config()
    selected_voice, cfg = voice_config(config, args.voice, args.agent)
    backend = args.backend or str(cfg.get("backend") or "auto")

    model = expand(cfg.get("model") or cfg.get("piper_model"))
    can_piper = have("piper") and bool(model) and Path(model).is_file()
    can_espeak = have("espeak-ng")
    resolved_backend = backend
    if backend == "auto":
        resolved_backend = "piper" if can_piper else "espeak"

    if args.json:
        print(json.dumps({
            "ok": True,
            "voice": selected_voice,
            "agent": args.agent,
            "backend": resolved_backend,
            "piper_model": model,
            "piper_config": expand(cfg.get("config") or cfg.get("piper_config")),
            "espeak_voice": cfg.get("espeak_voice"),
            "espeak_speed": cfg.get("espeak_speed"),
        }, separators=(",", ":")))
        return 0

    if resolved_backend == "piper":
        if speak_piper_server(text, selected_voice, cfg):
            return 0
        if not have("piper"):
            raise RuntimeError("piper not found; emerge media-sound/piper or use --backend espeak")
        speak_piper(text, cfg)
    elif resolved_backend in ("espeak", "espeak-ng"):
        if not can_espeak:
            raise RuntimeError("espeak-ng not found")
        speak_espeak(text, cfg)
    else:
        raise RuntimeError(f"unknown backend: {resolved_backend}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"zentoo-speak: {exc}", file=sys.stderr)
        raise SystemExit(1)

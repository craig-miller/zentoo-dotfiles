# Noctalia-generated theme files land inside the stowed (folded) package
# dirs because their parent .config/<app>/ is a directory symlink to here.
# Ignore them — they regenerate on every wallpaper or theme change.

foot/dot-config/foot/themes/

# Runtime-regenerated by noctalia on every palette/theme change.
# Tracked initially, untracked 2026-08-11 — noctalia regens them on
# fresh installs at first launch, so no need to seed from stow.
niri/dot-config/niri/noctalia.kdl
soundthemed/dot-config/soundthemed/config.toml
